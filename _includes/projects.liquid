<div class="col">
  <a class="project-card" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100">
      {% if project.img and page.hide_project_images != true %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.github %}
          <div class="project-meta">
            <i class="fa-brands fa-github" aria-hidden="true"></i>
            <span>{{ project.github | remove: 'https://github.com/' | remove: 'http://github.com/' }}</span>
            {% if project.github_stars %}
              <span class="stars" title="GitHub Stars">
                <i class="fa-solid fa-star"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </a>
</div>
